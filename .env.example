LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=your_api_key
GITLAB_TOKEN=glpat-xxxx

# SAM 3 — path to sam3.pt inside the container (default: /models/sam3.pt via volume mount)
SAM3_MODEL_PATH=/models/sam3.pt

# YOLO — model weights; Ultralytics auto-downloads if not found locally
YOLO_MODEL_PATH=yolo11n-seg.pt
YOLO_CONF=0.25
