# ─── Required ────────────────────────────────────────────────────────────────
# Label Studio API token. After the first `ls-cli init` (or `docker compose up`),
# get it from the LS UI:  Account & Settings → Access Token → Copy.
LABEL_STUDIO_API_KEY=

# ─── Label Studio admin login (created on first boot) ────────────────────────
LABEL_STUDIO_USERNAME=admin@example.com
LABEL_STUDIO_PASSWORD=changeme

# ─── YOLO model + training tuning ────────────────────────────────────────────
# Starting weights when the volume is empty. Variants: n/s/m/l/x (size).
# Only used on first boot — once you've trained, the newest run's weights win.
YOLO_DEFAULT_MODEL=yolo26m-seg.pt

# Optional. Defaults shown — uncomment to override.
# YOLO_CONF=0.25
# YOLO_TRAIN_EPOCHS=50
# YOLO_TRAIN_IMGSZ=640
# YOLO_TRAIN_BATCH=-1
# YOLO_TRAIN_LR0=0.01
# YOLO_TRAIN_FREEZE=0

# ─── Advanced overrides (rarely needed for local dev) ────────────────────────
# Where the CLI tells Label Studio to reach the model backends. Defaults are
# the docker-compose service names — change only if you run the model
# containers on a different host.
# SAM3_URL=http://sam3:9090
# YOLO_URL=http://yolo-seg:9090

# Postgres credentials are hardcoded as ls/lspass in infra/dev/docker-compose.ui.yml
# (LS reads them under POSTGRE_USER/POSTGRE_PASSWORD — note the missing S).
# To customize, edit the compose file; production secrets belong in infra/prod/.
