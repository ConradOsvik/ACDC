LABEL_STUDIO_URL=http://localhost:8080

# Get from Label Studio UI → Account & Settings → Access Token
LABEL_STUDIO_API_KEY=

# Defaults work for a local Docker stack (service names resolve on ls-net).
# Override if Label Studio or models are running elsewhere.
# Script uses MINIO_ENDPOINT (host-facing) to create the bucket.
# LS uses MINIO_LS_ENDPOINT (Docker-internal) to read/write objects.
MINIO_ENDPOINT=http://localhost:9000
MINIO_LS_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=labelstudio

# URLs that Label Studio uses to call the models (must be reachable from inside Docker).
SAM3_URL=http://sam3:9090
YOLO_URL=http://yolo-seg:9090
