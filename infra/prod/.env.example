LABEL_STUDIO_USERNAME=admin@yourteam.com
LABEL_STUDIO_PASSWORD=

# Public HTTPS URL where Label Studio is hosted. LS uses this to generate
# correct internal links and redirects. Must match what's in the browser bar.
LABEL_STUDIO_EXTERNAL_URL=https://labelstudio.example.com

# Get from Label Studio UI → Account & Settings → Access Token.
# Required by the setup script and ML backends.
LABEL_STUDIO_API_KEY=

POSTGRES_USER=ls
POSTGRES_PASSWORD=lspass

# URLs Label Studio uses to call the model backends for predictions.
# Must be reachable from wherever LS is hosted (not from your laptop).
SAM3_URL=https://sam3.example.com
YOLO_URL=https://yolo.example.com

# Model weights filename or path inside the container.
YOLO_MODEL_PATH=yolo26n-seg.pt
YOLO_CONF=0.25
